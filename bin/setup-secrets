#!/usr/bin/env bash
# Upload the secrets the Deploy workflow needs to this repo's GitHub
# Actions settings. Safe to re-run; existing values are overwritten.
#
#   CLASP_SCRIPT_ID  from the CLASP_SCRIPT_ID env var (.envrc)
#   CLASPRC_JSON     from ~/.clasprc.json (created by `clasp login`)
#
# Values go to gh on stdin so they never appear in the process list.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

clasprc="${HOME}/.clasprc.json"

if ! command -v gh >/dev/null 2>&1; then
  echo "setup-secrets: gh not found; install the GitHub CLI" >&2
  exit 1
fi

if ! gh repo view >/dev/null 2>&1; then
  echo "setup-secrets: no GitHub repo for this directory; add a remote first" >&2
  exit 1
fi

if [[ -z "${CLASP_SCRIPT_ID:-}" ]]; then
  echo "setup-secrets: CLASP_SCRIPT_ID is not set; add it to .envrc" >&2
  exit 1
fi

if [[ ! -f "${clasprc}" ]]; then
  echo "setup-secrets: ${clasprc} missing; run: clasp login" >&2
  exit 1
fi

printf '%s' "${CLASP_SCRIPT_ID}" | gh secret set CLASP_SCRIPT_ID
gh secret set CLASPRC_JSON < "${clasprc}"

if gh secret list | grep -q '^CLASP_JSON\b'; then
  gh secret delete CLASP_JSON
fi

gh secret list
